
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuotationStatus {
  RASCUNHO
  EMITIDA
  ACEITE
  REJEITADA
  EXPIRADA
}

enum OrderStatus {
  PENDENTE
  CONFIRMADA
  EM_PREPARACAO
  ENVIADA
  ENTREGUE
  CANCELADA
}

enum ContactStatus {
  NOVA
  EM_ANALISE
  RESPONDIDA
  ARQUIVADA
}
enum ContentType {
  SERVICOS
  PROJECTOS
  SOLUCOES
}

enum ContentStatus {
  RASCUNHO
  PUBLICADO
}

enum UserRole {
  CLIENTE
  GESTOR
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CLIENTE)
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([active])
}

model Quotation {
  id           String          @id @default(cuid())
  quoteNumber  String          @unique

  // Dados do cliente
  customerName String
  company      String?
  phone        String
  email        String?
  address      String?

  // Valores financeiros
  subtotal     Decimal         @db.Decimal(12, 2)
  ivaTotal     Decimal         @db.Decimal(12, 2)
  total        Decimal         @db.Decimal(12, 2)

  currency     String          @default("MZN")

  // Gestão da cotação
  status       QuotationStatus @default(RASCUNHO)
  notes        String?
  validUntil   DateTime?

  items        QuotationItem[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([customerName])
}
model QuotationItem {
  id          String  @id @default(cuid())

  quotationId String
  productId   String?

  // Dados históricos
  productName String
  productImage String?

  quantity    Int

  // Valores unitários e fiscais
  unitPrice   Decimal @db.Decimal(12, 2)
  ivaRate     Decimal @db.Decimal(5, 2)

  // Valores totais da linha
  subtotal    Decimal @db.Decimal(12, 2)
  ivaAmount   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  quotation   Quotation @relation(fields: [quotationId],references: [id],onDelete: Cascade)

  product     Product? @relation(fields: [productId],references: [id],onDelete: SetNull)

  @@index([quotationId])
  @@index([productId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  active      Boolean   @default(true)

  // Gestão da barra principal
  showInNav   Boolean   @default(false)
  navOrder    Int?

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())

  // Identificação do componente
  code        String?  @unique
  name        String
  slug        String   @unique
  description String?

  price       Decimal  @db.Decimal(12, 2)
  oldPrice    Decimal? @db.Decimal(12, 2)

  // IVA configurável por produto (percentagem)
  ivaRate     Decimal  @default(16.00) @db.Decimal(5, 2)

  image       String
  images      String[] @default([])

  rating      Float    @default(0)
  inStock     Boolean  @default(true)

  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  promotion   Boolean  @default(false)

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  orderItems      OrderItem[]
  quotationItems  QuotationItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([active])
}
model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique

  // Dados do cliente
  customerName  String
  phone         String
  email         String?
  address       String
  district      String?
  notes         String?

  // Valores financeiros
  subtotal      Decimal     @db.Decimal(12, 2)
  deliveryFee   Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)

  // Estado da encomenda
  status        OrderStatus @default(PENDENTE)

  items         OrderItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

model OrderItem {
  id          String   @id @default(cuid())

  orderId     String
  productId   String?

  // Dados históricos do produto
  productName String
  quantity    Int

  // Preço no momento da encomenda
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  order       Order    @relation(fields: [orderId],references: [id],onDelete: Cascade)

  product     Product? @relation( fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model ContactMessage {
  id        String        @id @default(cuid())

  // Dados do remetente
  name      String
  email     String
  phone     String?

  // Conteúdo da mensagem
  subject   String
  message   String

  // Gestão administrativa
  status    ContactStatus @default(NOVA)
  response  String?

  // Controlo
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model SiteContent {
  id          String        @id @default(cuid())

  title       String
  slug        String        @unique
  type        ContentType

  // Conteúdo
  summary     String?
  content     String        @db.Text

  // Imagens
  image       String?
  images      String[]      @default([])

  // Organização
  order       Int           @default(0)

  // Publicação
  status      ContentStatus @default(RASCUNHO)
  publishedAt DateTime?

  // Controlo
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status])
  @@index([status, publishedAt])
  @@index([order])
}
