generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id              String    @id @default(cuid())
  name            String
  email           String?   @unique
  password        String?
  phone           String?   @unique
  pinHash         String?
  phoneVerifiedAt DateTime?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  role            UserRole  @default(CLIENTE)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cart Cart?

  @@index([role])
  @@index([active])
}


model Quotation {
  id              String          @id @default(cuid())
  quoteNumber     String          @unique
  customerName    String
  company         String?
  phone           String
  email           String?
  address         String?
  subtotalOriginal Decimal        @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal          @default(0) @db.Decimal(12, 2)
  total           Decimal          @db.Decimal(12, 2)
  currency        String           @default("MZN")
  status          QuotationStatus  @default(RASCUNHO)
  notes           String?
  validUntil      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customerType    CustomerType     @default(INDIVIDUAL)
  nuit            String?
  items           QuotationItem[]

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([customerName])
  @@index([nuit])
}

model QuotationItem {
  id                String    @id @default(cuid())
  quotationId       String
  productId         String?
  productName       String
  productImage      String?
  quantity          Int
  originalUnitPrice Decimal   @default(0) @db.Decimal(12, 2)
  unitPrice         Decimal   @db.Decimal(12, 2)
  total             Decimal   @db.Decimal(12, 2)

  product           Product?  @relation(fields: [productId], references: [id])
  quotation         Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([productId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  navOrder    Int?
  showInNav   Boolean   @default(false)
  products    Product[]
}

model Product {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  price          Decimal         @db.Decimal(12, 2)
  oldPrice       Decimal?        @db.Decimal(12, 2)
  image          String
  images         String[]        @default([])
  rating         Float           @default(0)
  active         Boolean         @default(true)
  featured       Boolean         @default(false)
  categoryId     String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  promotion      Boolean         @default(false)
  inStock        Boolean         @default(true)
  ivaRate        Decimal         @default(16.00) @db.Decimal(5, 2)
  code           String?         @unique
  orderItems     OrderItem[]
  category       Category        @relation(fields: [categoryId], references: [id])
  quotationItems QuotationItem[]
  cartItems CartItem[]

  @@index([categoryId])
  @@index([active])
}

model Order {
  id           String       @id @default(cuid())
  orderNumber  String       @unique
  customerName String
  phone        String
  email        String?
  address      String
  district     String?
  notes        String?
  deliveryFee  Decimal      @default(0) @db.Decimal(12, 2)
  total        Decimal      @db.Decimal(12, 2)
  status       OrderStatus  @default(PENDENTE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  customerType CustomerType @default(INDIVIDUAL)
  company      String?
  nuit         String?
  items        OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([nuit])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String?
  productName       String
  quantity          Int
  unitPrice         Decimal  @db.Decimal(12, 2)
  originalUnitPrice Decimal? @db.Decimal(12, 2)
  total             Decimal  @db.Decimal(12, 2)

  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(NOVA)
  response  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model SiteContent {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  type        ContentType
  summary     String?
  content     String
  image       String?
  videoUrl    String?       // Link do vídeo no YouTube
  order       Int           @default(0)
  status      ContentStatus @default(RASCUNHO)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  images      String[]      @default([])

  @@index([type, status])
  @@index([status, publishedAt])
  @@index([order])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  quantity   Int      @default(1)
  selecionado Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

enum QuotationStatus {
  RASCUNHO
  EMITIDA
  ACEITE
  REJEITADA
  EXPIRADA
}

enum OrderStatus {
  PENDENTE
  CONFIRMADA
  EM_PREPARACAO
  ENVIADA
  ENTREGUE
  CANCELADA
}

enum ContactStatus {
  NOVA
  EM_ANALISE
  RESPONDIDA
  ARQUIVADA
}

enum ContentType {
  SERVICOS
  PROJECTOS
  SOLUCOES
}

enum ContentStatus {
  RASCUNHO
  PUBLICADO
}

enum UserRole {
  CLIENTE
  GESTOR
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}
